# Copy to .env and fill in from Supabase: Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-key

# Frontend origins allowed to call the API (comma-separated)
FRONTEND_ORIGINS=http://localhost:5173

# RunPod Serverless (optional AI text; npm run dev only, production builds use the rule-based text)
# RUNPOD_API_KEY stays in the Vite dev server proxy and is never sent to the browser.
RUNPOD_API_KEY=
VITE_RUNPOD_ENABLED=false
VITE_RUNPOD_ENDPOINT_ID=s3yoz365sju59f
VITE_RUNPOD_MODEL=Qwen/Qwen2.5-7B-Instruct
